# Copy to .env and fill in. Placeholder values only; never commit the real file.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/automation
REDIS_URL=redis://localhost:56379
# At least 16 characters. Generate one with: openssl rand -hex 24
MCP_BEARER_TOKEN=change-me-to-a-long-random-token
# Optional. Defaults to a placeholder address; put your real one only in your local .env.
SEED_USER_EMAIL=user@example.invalid
# Interface to listen on. Loopback by default.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Bundesagentur: scheduled when this is set (minutes, integer, at least 1). What it searches for comes from the
# active Targets in the database (upsert_target), never from the environment.
BUNDESAGENTUR_INTERVAL_MINUTES=60
# Bambase needs no search criteria: it is scheduled when this is set (minutes, integer, at least 1).
BAMBASE_INTERVAL_MINUTES=60
# Minutes between Gone cold checks (integer, at least 1; default 1440, daily). The number of silent days is the
# Global default goneColdDays (update_global_defaults); null turns the check off.
GONE_COLD_INTERVAL_MINUTES=1440
# Postings per Target per run the prerank passes on when no Target or Global default sets prerankTopN.
PRERANK_TOP_N=20
# Company boards (Greenhouse, Lever, Ashby): each is scheduled when its interval is set (minutes). Only
# marked boards of the Board directory are fetched; load it with pnpm --filter @job-portal/worker boards:import
# and boards:mark.
GREENHOUSE_INTERVAL_MINUTES=
LEVER_INTERVAL_MINUTES=
ASHBY_INTERVAL_MINUTES=
# AI fit scoring: choose a runner, or leave AI_RUNNER empty to score nothing. No fallback between runners.
# openrouter needs OPENROUTER_API_KEY (secret, never commit it) and OPENROUTER_MODEL.
# claude needs CLAUDE_MODEL; CLAUDE_BINARY_PATH defaults to claude on PATH, CLAUDE_EFFORT to low (low, medium, high, xhigh, max).
AI_RUNNER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLAUDE_BINARY_PATH=
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Most AI calls one run makes (integer, at least 1). A throughput limit, not a spend cap: pairs left over wait for the next run.
AI_MAX_CALLS_PER_RUN=50
# AI merge: two Jobs of one company and city whose titles share at least this fraction of their words (0 to 1) are checked by the AI, and at most this many checks run per run (integer, at least 1; a throughput limit, not a spend cap).
AI_MERGE_JACCARD=0.6
AI_MERGE_MAX_CALLS_PER_RUN=20
# Gmail reply reading: one inbox, read-only, with its own OAuth refresh token. The three secrets come together or not
# at all; set them only in your local .env. Unset means the mail poll is skipped (it also needs AI_RUNNER).
# GMAIL_INTERVAL_MINUTES defaults to 15; GMAIL_START_DATE (YYYY-MM-DD) is the earliest mail read, default the first poll.
# AI_MAIL_MAX_CALLS_PER_RUN is a throughput limit per poll, not a spend cap.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INTERVAL_MINUTES=15
GMAIL_START_DATE=
AI_MAIL_MAX_CALLS_PER_RUN=20
GMAIL_MAX_READ_FAILURES=3
# A fit score at or above this tags the Job with the Target, unless the Target or the Global defaults set one (0 to 100).
ALERT_THRESHOLD=70
# Telegram digest and failure alerts through the n8n webhook. Both are secrets: set them only in your local
# .env. Unset means nothing is sent; setting only one of the two stops the process at start (ConfigError). NOTIFY_MAX_ATTEMPTS sends per message (at least 1) and NOTIFY_BACKOFF_MS
# the wait before the second send (doubles after that) bound how long a run waits for a down webhook.
NOTIFY_WEBHOOK_URL=
NOTIFY_TOPIC_ID=
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_MS=1000
# At most this many requests per second to each ATS host (above 0, decimals allowed).
BOARD_REQUESTS_PER_SECOND=2
