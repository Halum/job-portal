# Copy to .env and fill in. Placeholder values only; never commit the real file.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/automation
REDIS_URL=redis://localhost:56379
# At least 16 characters. Generate one with: openssl rand -hex 24
MCP_BEARER_TOKEN=change-me-to-a-long-random-token
# Optional. Defaults to a placeholder address; put your real one only in your local .env.
SEED_USER_EMAIL=user@example.invalid
# Interface to listen on. Loopback by default.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Bundesagentur search, as API query parameters. Unset means the source is not scheduled.
# Placeholder only; put your real search in your local .env.
BUNDESAGENTUR_QUERY=wo=Musterstadt&umkreis=25
# How often the worker polls it, in minutes (integer, at least 1).
BUNDESAGENTUR_INTERVAL_MINUTES=60
# Bambase needs no search criteria: it is scheduled when this is set (minutes, integer, at least 1).
BAMBASE_INTERVAL_MINUTES=60
