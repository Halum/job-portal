set -e
pnpm typecheck
pnpm lint
pnpm test:fast
# Heavy scanners are optional locally; CI always runs them.
if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --redact; else echo "pre-commit: gitleaks not installed, skipped (CI runs it)"; fi
if command -v osv-scanner >/dev/null 2>&1; then osv-scanner scan source --lockfile=pnpm-lock.yaml; else echo "pre-commit: osv-scanner not installed, skipped (CI runs it)"; fi
if command -v semgrep >/dev/null 2>&1; then semgrep scan --config auto --error --quiet apps packages; else echo "pre-commit: semgrep not installed, skipped (CI runs it)"; fi
